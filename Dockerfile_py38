# Base image with CUDA
FROM nvidia/cuda:11.1.1-devel

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-key adv --fetch-keys https://developer.download.nvidia.com/compute/cuda/repos/ubuntu1804/x86_64/3bf863cc.pub
RUN apt-get update && apt-get install -y \
    wget curl git build-essential \
    ffmpeg libsm6 libxext6 libxrender-dev libglib2.0-0 \
    libtiff5-dev htop ca-certificates sudo \
    && rm -rf /var/lib/apt/lists/*

# Install Miniforge (Python 3.8)
ENV CONDA_DIR=/opt/conda
ENV PATH=$CONDA_DIR/bin:$PATH

RUN wget https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/miniforge.sh && \
    bash /tmp/miniforge.sh -b -p $CONDA_DIR && \
    rm /tmp/miniforge.sh && \
    conda clean -afy

# Create a new conda environment with Python 3.8
RUN conda create -n acformer python=3.8 -y

# Activate conda environment by default
SHELL ["conda", "run", "-n", "acformer", "/bin/bash", "-c"]

# Install Python packages via pip and conda (inside the env)
RUN pip install --upgrade pip && \
    pip install torch==1.10.1+cu111 torchvision==0.11.2+cu111 torchaudio==0.10.1 -f https://download.pytorch.org/whl/cu111/torch_stable.html && \
    pip install mmcv-full==1.6.1 -f https://download.openmmlab.com/mmcv/dist/cu111/torch1.10.0/index.html && \
    pip install pandas matplotlib opencv-python yapf==0.40.1 "albumentations>=0.3.2" --no-binary imgaug,albumentations

# Install openslide
RUN conda install -y -c conda-forge openslide

# Clone and install ACFormer and MMDetection
WORKDIR /App
RUN git clone https://github.com/LL3RD/ACFormer.git
WORKDIR /App/ACFormer/thirdparty/mmdetection
RUN pip install -e .
WORKDIR /App/ACFormer
RUN pip install -e .
RUN conda install -y ipykernel && \
    python -m ipykernel install --prefix=/opt/conda --name acformer --display-name 'Python38_acformer'
ENV CONDA_DEFAULT_ENV=acformer
ENV CONDA_PREFIX=/opt/conda/envs/$CONDA_DEFAULT_ENV
ENV PATH=$CONDA_PREFIX/bin:$PATH
RUN source /opt/conda/etc/profile.d/conda.sh

# Final working directory (optional)
WORKDIR /rsrch5/home/trans_mol_path/cercan/
